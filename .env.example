# Lokal enkeltbrukerklient. Behold loopback-adressen.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000

# HelseID TEST via Test-token-tjenesten (TTT). Ingen registrert OAuth-klient kreves.
HELSEID_AUTH_MODE=test-token
# Hent API-nøkkel under Integrasjonstesting: https://selvbetjening.test.nhn.no/ttt
HELSEID_TTT_API_KEY=
# Valgfri klient-ID (UUID) for testtoken, hvis NHN har gitt deg en bestemt ID.
# Tom verdi gir en automatisk test-ID som beholdes til serveren startes på nytt.
HELSEID_TTT_CLIENT_ID=
# Forslag for Helsenorge Ekstern API / Oppgave i test.
# Verdiene er brukt til tokenuthenting; tilgang i Helsenorge avhenger av testoppsettet.
HELSEID_TTT_AUDIENCE=nhn:helsenorge.eksternapi
HELSEID_SCOPE=nhn:helsenorge.eksternapi/Oppgave
# Oppgi organisasjonsnummeret til en testvirksomhet du har tilgang til (hovedenhet).
HELSEID_ORGNR_PARENT=
HELSEID_ORGNR_CHILD=

# Alternativ: registrert HelseID-klient. Sett HELSEID_AUTH_MODE=client_credentials.
# Disse variablene brukes ikke av TTT; ingen nøkkelfil trengs i TTT-modus.
# Kontroller at HELSEID_SCOPE over samsvarer med den registrerte klientens tilgang.
HELSEID_CLIENT_ID=
HELSEID_PRIVATE_KEY_FILE=
HELSEID_KEY_ID=
HELSEID_SIGNING_ALG=PS256
# Gjelder bare registrert klient: true for multi-tenant med gyldig delegering.
HELSEID_MULTI_TENANT=false

# Velg Test01 eller Test02 ved sendeknappen i appen (standard: Test02).
# Målene er faste; vilkårlige URL-er og produksjon støttes ikke.
# Fast issuer: https://helseid-sts.test.nhn.no
# Bruk HTTPS_PROXY og NODE_EXTRA_CA_CERTS hvis nettverket krever proxy / egen CA.
